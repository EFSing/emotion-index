[Unit]
Description=Capture CN emotion index inputs
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=emotion-index
Group=emotion-index
WorkingDirectory=/opt/emotion-index
EnvironmentFile=/etc/emotion-index/emotion-index.env
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
TimeoutStartSec=15min
ExecStart=/usr/bin/flock /opt/emotion-index/.runtime/tmp/scheduled.lock /opt/emotion-index/.venv/bin/emotion-index capture --market CN --current-session
